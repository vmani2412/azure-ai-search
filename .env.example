AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

AZURE_SEARCH_ENDPOINT=https://learnaisearch24.search.windows.net
AZURE_SEARCH_API_KEY=your-azure-search-admin-api-key
AZURE_SEARCH_INDEX=azureblob-index
AZURE_SEARCH_TOP_K=3

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=aisearchlearn24;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=product

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs_collection
QDRANT_TOP_K=3
DOCS_DIR=docs

LLM_TIMEOUT_S=30.0
LLM_MAX_RETRIES=3
LLM_BASE_DELAY_S=1.0
LLM_MAX_DELAY_S=8.0
LOG_LEVEL=INFO
